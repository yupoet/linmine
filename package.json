{
  "name": "lin-mine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lin Mine - a 3D tap-to-dig mining adventure in the spirit of Pocket Mine 2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/sim.ts",
    "deploy": "npm run build && wrangler pages deploy dist --project-name linmine --branch main"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9",
    "wrangler": "^4.71.0"
  }
}
